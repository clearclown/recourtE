# =============================================================================
# recourtE Ingest 環境変数
# =============================================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# データベース (必須)
# -----------------------------------------------------------------------------
TURSO_DATABASE_URL=http://localhost:8080
TURSO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# AIプロバイダー設定
# -----------------------------------------------------------------------------
# AI_PROVIDER: 使用するLLMプロバイダーを選択
#   gemini   - Google Gemini (デフォルト)
#   claude   - Anthropic Claude
#   openai   - OpenAI
#   deepseek - DeepSeek
#   grok     - xAI Grok
#   local    - ローカルLLM (LM Studio, Ollama 等、OpenAI互換API)
AI_PROVIDER=gemini

# AI_MODEL: モデル名 (省略時はプロバイダーごとのデフォルトを使用)
#   gemini   → gemini-2.5-flash-preview-05-20
#   claude   → claude-sonnet-4-5-20250929
#   openai   → gpt-4.1
#   deepseek → deepseek-chat
#   grok     → grok-3
#   local    → default
# AI_MODEL=

# -----------------------------------------------------------------------------
# プロバイダー別 APIキー (選択したプロバイダーのキーのみ設定すればOK)
# -----------------------------------------------------------------------------

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Claude
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Grok (xAI)
# XAI_API_KEY=

# ローカルLLM (OpenAI互換エンドポイント)
# ホスト直接実行: http://localhost:1234/v1
# コンテナ経由実行: http://host.containers.internal:1234/v1
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# -----------------------------------------------------------------------------
# Cloudflare R2 ストレージ (オプション: 未設定ならスキップ)
# -----------------------------------------------------------------------------
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# R2_BUCKET=

# -----------------------------------------------------------------------------
# クロール設定
# -----------------------------------------------------------------------------
# CRAWL_JSONL_PATH=path/to/crawl.jsonl
# CRAWL_START_DATE=2024-01-01
# CRAWL_END_DATE=2026-01-01
# CRAWL_VERSION=v1

# -----------------------------------------------------------------------------
# プロンプト (オプション: デフォルトの判例解析プロンプトを上書き)
# -----------------------------------------------------------------------------
# AI_PROMPT=あなたは最高裁判所の判例読解支援AIです。...
